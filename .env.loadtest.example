# ==============================================================================
# ROSH Control Tower — Load Test & Video Quality Configuration
# ==============================================================================
# Copy this file to `.env.loadtest` at the repository root:
#   copy .env.loadtest.example .env.loadtest
#
# Both `tools/load-test/run-load-test.mjs` and `video-quality/playwright.config.ts`
# automatically read `.env.loadtest`.
# ==============================================================================

# Target environment: "local" or "dev"
LOAD_TEST_ENV=local

# When LOAD_TEST_ENV=dev, set your Tailscale MagicDNS hostname here:
# Example: roshai-control-tower.tail12345.ts.net
TAILNET_HOST=

# ------------------------------------------------------------------------------
# Test Parameters
# ------------------------------------------------------------------------------
# Number of bots to spawn (default: 3)
TEST_BOT_COUNT=3

# Duration in seconds for the measurement window (default: 180 for video, 60 standard)
TEST_DURATION=180

# Optional: leave empty to automatically generate TEST-VIN-001..N from TEST_BOT_COUNT.
# Only specify if you want to test a custom list of specific VINs.
TEST_VINS=

# ------------------------------------------------------------------------------
# Explicit URL Overrides (Optional)
# Leave empty to auto-derive from LOAD_TEST_ENV and TAILNET_HOST:
#
#   When LOAD_TEST_ENV=local:
#     BACKEND_HTTP_URL  = http://localhost:3000
#     MQTT_BROKER_URL   = mqtt://localhost:1883
#     RTSP_PUBLISH_BASE = rtsp://localhost:8554
#     WHEP_BASE_URL     = http://127.0.0.1:8889
#
#   When LOAD_TEST_ENV=dev:
#     BACKEND_HTTP_URL  = https://${TAILNET_HOST}
#     MQTT_BROKER_URL   = wss://${TAILNET_HOST}/mqtt
#     RTSP_PUBLISH_BASE = rtsp://${TAILNET_HOST}:8554
#     WHEP_BASE_URL     = https://${TAILNET_HOST}/webrtc
# ------------------------------------------------------------------------------
BACKEND_HTTP_URL=

MQTT_BROKER_URL=
RTSP_PUBLISH_BASE=
WHEP_BASE_URL=

# ------------------------------------------------------------------------------
# Target Environment Credentials
# (If left empty, falls back to docker/.env)
# ------------------------------------------------------------------------------
MOSQUITTO_BACKEND_USERNAME=backend-service
MOSQUITTO_BACKEND_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
