PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://roshai:changeme@localhost:5432/roshai
REDIS_URL=redis://localhost:6379
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=backend-service
MQTT_PASSWORD=changeme-mqtt

# Object storage (MinIO) — host-published port for local dev, same as the
# other services above. Reuses the MinIO root credential for now (no
# scoped backend-only MinIO user exists yet — see CLAUDE.md Open Items).
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=roshai
S3_SECRET_ACCESS_KEY=changeme12345

# Used only by `npx prisma db seed` to create the first admin user —
# not read by the running server.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme-admin

# OIDC (Microsoft Entra ID today, swappable to any spec-compliant
# provider later — see CLAUDE.md "Auth"). Values come from the Entra App
# Registration (Azure Portal): OIDC_ISSUER_URL uses the tenant's Directory
# (tenant) ID, OIDC_CLIENT_ID is the Application (client) ID, and
# OIDC_CLIENT_SECRET is a generated client secret's value. Backend and
# frontend run on the same port (3000) by default (see frontend's
# vite.config.ts) — if both run locally at once, Vite auto-picks the next
# free port and logs it; set OIDC_POST_LOGIN_REDIRECT to match whatever
# port the frontend dev server actually reports.
OIDC_ISSUER_URL=https://login.microsoftonline.com/{tenant-id}/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/callback
OIDC_POST_LOGIN_REDIRECT=http://localhost:3001/vehicles

# RTSP base the backend hands bots in video/control START commands.
# Local dev: point at the MediaMTX started by tools/run-local-mediamtx.sh
# (rtsp://localhost:8554). Note: `tsx watch` does not auto-load this file —
# the host-run backend (npm run dev --workspace=backend) needs this exported
# in its launching shell (the Docker path gets it from docker/.env instead).
VIDEO_RTSP_BASE_URL=
