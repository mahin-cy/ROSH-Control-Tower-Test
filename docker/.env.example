# Postgres
POSTGRES_USER=roshai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=roshai
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=roshai
MINIO_ROOT_PASSWORD=changeme12345
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mosquitto
MOSQUITTO_PORT=1883
MOSQUITTO_BACKEND_USERNAME=backend-service
MOSQUITTO_BACKEND_PASSWORD=changeme-mqtt

# Tailscale — laptop/server sidecar joins the tailnet; Traefik rides on its
# network namespace instead of publishing a public port (no public exposure
# needed at all — see CLAUDE.md's Tailscale migration notes).
# TS_AUTHKEY: generate in the Tailscale admin console (Settings > Keys),
#   reusable, tagged tag:server. Left blank on purpose (not "changeme") so
#   startup fails loudly instead of silently running an unauthenticated
#   sidecar. Expires on a schedule (default 90 days) — rotate before then.
# TS_TAILNET_DOMAIN: the tailnet's MagicDNS domain (Settings > DNS), e.g.
#   something like "tailxxxxx.ts.net" — used to request the TLS cert for
#   "${TS_HOSTNAME}.${TS_TAILNET_DOMAIN}".
TS_AUTHKEY=
TS_HOSTNAME=roshai-control-tower
TS_TAILNET_DOMAIN=

# Backend
BACKEND_PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://roshai:changeme@postgres:5432/roshai
REDIS_URL=redis://redis:6379
MQTT_BROKER_URL=mqtt://mosquitto:1883

# Used only by `npx prisma db seed` to create the first admin user.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme-admin

# OIDC (Microsoft Entra ID today, swappable to any spec-compliant provider
# later — see CLAUDE.md "Auth"). Values come from the Entra App
# Registration (Azure Portal): OIDC_ISSUER_URL uses the tenant's Directory
# (tenant) ID, OIDC_CLIENT_ID is the Application (client) ID,
# OIDC_CLIENT_SECRET is a generated client secret's value. Traefik puts
# frontend and backend behind one tailnet hostname (path-routed), so
# OIDC_REDIRECT_URI/OIDC_POST_LOGIN_REDIRECT use that same
# "${TS_HOSTNAME}.${TS_TAILNET_DOMAIN}" host as TS_TAILNET_DOMAIN above.
OIDC_ISSUER_URL=https://login.microsoftonline.com/{tenant-id}/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://roshai-control-tower.{tailnet-domain}/api/v1/auth/oidc/callback
OIDC_POST_LOGIN_REDIRECT=https://roshai-control-tower.{tailnet-domain}/vehicles

# Live video (Phase 2) — RTSP base URL the backend sends to the bot in
# each VideoControlCommand.ingestUrl (see video-control-service.ts).
# Decided Sep 2026: RTSP replaced WHIP for bot ingest (browser playback
# is unaffected, still WHEP via Traefik's /webrtc). Must be reachable BY
# THE BOT — this does NOT go through Traefik (RTSP isn't HTTP), so it's
# the tailnet hostname + MediaMTX's published RTSP port directly, not a
# /webrtc-style path like OIDC_REDIRECT_URI above.
VIDEO_RTSP_BASE_URL=rtsp://roshai-control-tower.{tailnet-domain}:8554
